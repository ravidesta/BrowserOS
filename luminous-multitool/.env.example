# Luminous Multitool — environment config
# Copy to .env and adjust.

NODE_ENV=development

# Public-facing domain (use localhost for local dev)
LUMINOUS_DOMAIN=localhost
LUMINOUS_ROOT_URL=http://localhost:3000/
LUMINOUS_HTTP_PORT=3000
LUMINOUS_SSH_PORT=2222
LUMINOUS_API_PORT=4000

# Postgres
POSTGRES_DB=luminous
POSTGRES_USER=luminous
POSTGRES_PASSWORD=change-me-in-production

# Forgejo — generate an admin token after first signup via the UI:
# Settings > Applications > Generate Token (scopes: write:admin, write:user, write:repository)
FORGEJO_ADMIN_TOKEN=

# Stripe Connect — needed for marketplace billing
# Get keys from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# OpenTimestamps — calendar server for bitcoin anchoring
OTS_CALENDAR_URL=https://alice.btc.calendar.opentimestamps.org
